struct OverlappingSlices {
    in a: u3,
    in b: u3,
}

// The assignments overlap on p[3:2], requiring dut.a[2:1] == dut.b[1:0].
// Both observations happen in the same cycle; p[0] remains unknown.
prot overlapping_slices<dut: OverlappingSlices>(p: u5) {
    dut.a := p[3:1];
    dut.b := p[4:2];
    step();
}
