---
source: protocols/src/frontend/serialize.rs
expression: content
---
struct Mux {
  in a: u8,
  in b: u8,
  in sel: u1,
  out y: u8,
}

prot first<DUT: Mux>(inputs: (u32,u64), y: u8) {
  DUT.a := inputs.0[7:0];
  DUT.b := inputs.1[7:0];
  DUT.sel := 1'd0;
  assert_eq(DUT.y, y);
  step();
}

prot second<DUT: Mux>(inputs: (u32,u64), y: u8) {
  DUT.a := inputs.0[7:0];
  DUT.b := inputs.1[7:0];
  DUT.sel := 1'd1;
  assert_eq(DUT.y, y);
  step();
}
