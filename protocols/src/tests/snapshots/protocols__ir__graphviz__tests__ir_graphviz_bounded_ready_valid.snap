digraph "send_data" {
  rankdir=LR;
  node [shape=box];
  entry_marker [shape=plain,label="ENTRY"];
  entry_marker -> node0;
  node0 [label="[1] D.valid := 1 if D.ready; 1 if D.ready; 1 if not(D.ready); 1 if D.ready; 1; 1; $previous_valid if not($previous_valid_is_x)\n[1] $previous_valid := 1\n[1] $previous_valid_is_x := 0\n[1] D.data := data if D.ready; data if D.ready; data if not(D.ready); data if D.ready; data; data; data; $previous_data if not($previous_data_is_x)\n[1] $previous_data := data\n[1] $previous_data_is_x := 0"];
  node0 -> node8 [label="not(D.ready) / step"];
  node0 -> node1 [label="D.ready / step"];
  node8 [label="[1] D.valid := X if $previous_valid_is_x; $previous_valid if and(D.ready, not($previous_valid_is_x)); $previous_valid if and(D.ready, not($previous_valid_is_x)); $previous_valid if and(D.ready, not($previous_valid_is_x)); $previous_valid if not(or(D.ready, $previous_valid_is_x)); $previous_valid if and(D.ready, not($previous_valid_is_x)); $previous_valid if not($previous_valid_is_x)\n[1] $previous_valid := $previous_valid\n[1] $previous_valid_is_x := $previous_valid_is_x\n[1] D.data := X if $previous_data_is_x; $previous_data if and(D.ready, not($previous_data_is_x)); $previous_data if and(D.ready, not($previous_data_is_x)); $previous_data if and(D.ready, not($previous_data_is_x)); $previous_data if not(or(D.ready, $previous_data_is_x)); $previous_data if and(D.ready, not($previous_data_is_x)); $previous_data if not($previous_data_is_x)\n[1] $previous_data := $previous_data\n[1] $previous_data_is_x := $previous_data_is_x"];
  node8 -> node5 [label="not(D.ready) / step"];
  node8 -> node1 [label="D.ready / step"];
  node1 [label="[1] done\n[1] D.valid := X; $previous_valid if 0\n[1] $previous_valid := $previous_valid\n[1] $previous_valid_is_x := 1\n[1] D.data := X; $previous_data if 0\n[1] $previous_data := $previous_data\n[1] $previous_data_is_x := 1"];
  node5 [label="[1] assert_eq(D.ready, 1)\n[1] D.valid := X if $previous_valid_is_x; $previous_valid if not($previous_valid_is_x); $previous_valid if not($previous_valid_is_x); $previous_valid if not($previous_valid_is_x); $previous_valid if not($previous_valid_is_x)\n[1] $previous_valid := $previous_valid\n[1] $previous_valid_is_x := $previous_valid_is_x\n[1] D.data := X if $previous_data_is_x; $previous_data if not($previous_data_is_x); $previous_data if not($previous_data_is_x); $previous_data if not($previous_data_is_x); $previous_data if not($previous_data_is_x)\n[1] $previous_data := $previous_data\n[1] $previous_data_is_x := $previous_data_is_x"];
  node5 -> node1 [label="1 / step"];
}

