== simplified monitor ==
digraph "send_data" {
  rankdir=LR;
  node [shape=box];
  entry_marker [shape=plain,label="ENTRY"];
  entry_marker -> node0;
  node0 [label="[1] assert_eq(D.valid, 1)\n[1] $monitor_data_value := D.data"];
  node0 -> node1 [label="not(D.ready) / step"];
  node0 -> node2 [label="D.ready / step"];
  node1 [label="[1] assert_eq(D.valid, 1)\n[1] assert_eq($monitor_data_value, D.data)"];
  node1 -> node3 [label="not(D.ready) / step"];
  node1 -> node2 [label="D.ready / step"];
  node2 [label="[1] done"];
  node3 [label="[1] assert_eq(D.ready, 1)\n[1] assert_eq(D.valid, 1)\n[1] assert_eq($monitor_data_value, D.data)"];
  node3 -> node2 [label="1 / step"];
}
