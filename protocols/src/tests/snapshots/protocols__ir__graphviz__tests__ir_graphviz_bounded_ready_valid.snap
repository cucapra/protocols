== post-contract ==
digraph "send_data" {
  rankdir=LR;
  node [shape=box];
  entry_marker [shape=plain,label="ENTRY"];
  entry_marker -> node0;
  node0 [label="[1] D.valid := 1\n[1] $previous_valid := ite(1, 1, $previous_valid); ite(1, $previous_valid, $previous_valid)\n[1] $previous_valid_is_x := ite(0, 1, ite(1, 0, 1)); ite(1, 1, ite(0, 0, $previous_valid_is_x))\n[1] D.data := data\n[1] $previous_data := ite(1, data, $previous_data); ite(1, $previous_data, $previous_data)\n[1] $previous_data_is_x := ite(0, 1, ite(1, 0, 1)); ite(1, 1, ite(0, 0, $previous_data_is_x))"];
  node0 -> node11 [label="not(D.ready) / step"];
  node0 -> node2 [label="D.ready / step"];
  node11 [label="[1] D.valid := X if $previous_valid_is_x; $previous_valid if not($previous_valid_is_x)\n[1] D.data := X if $previous_data_is_x; $previous_data if not($previous_data_is_x)"];
  node11 -> node7 [label="not(D.ready) / step"];
  node11 -> node2 [label="D.ready / step"];
  node2 [label="[1] D.valid := X; $previous_valid if not($previous_valid_is_x)\n[1] D.data := X; $previous_data if not($previous_data_is_x)\n[1] done\n[1] $previous_valid := ite(1, $previous_valid, $previous_valid)\n[1] $previous_valid_is_x := ite(1, 1, ite(0, 0, $previous_valid_is_x))\n[1] $previous_data := ite(1, $previous_data, $previous_data)\n[1] $previous_data_is_x := ite(1, 1, ite(0, 0, $previous_data_is_x))"];
  node7 [label="[1] D.valid := X if $previous_valid_is_x; $previous_valid if not($previous_valid_is_x)\n[1] D.data := X if $previous_data_is_x; $previous_data if not($previous_data_is_x)\n[1] assert_eq(D.ready, 1)"];
  node7 -> node2 [label="1 / step"];
}

