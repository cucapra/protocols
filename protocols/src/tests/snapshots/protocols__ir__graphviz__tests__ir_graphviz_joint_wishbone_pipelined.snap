  node1 [label="[1] $monitor_live_3#0_write := 0 if or(self.RST, not(self.CYC)); $monitor_live_3#0_write if 1\n[1] $monitor_live#0_reset := 0 if and(self.ACK, or(or(not(self.RST), self.CYC), self.STB)); 1 if self.ACK\n[1] $monitor_live_1#0_idle_no_cycle := 0 if and(self.ACK, or(self.RST, self.CYC)); 1 if self.ACK\n[1] $monitor_live_2#0_idle_continue_cycle := 0 if and(self.ACK, or(or(self.RST, not(self.CYC)), self.STB)); 1 if self.ACK\n[1] $monitor_mask_value#1_write := self.SEL if self.ACK\n[1] $monitor_addr_value#1_write := self.ADR if self.ACK\n[1] $monitor_data_value#1_write := self.DAT_O if self.ACK\n[1] $monitor_live_3#1_write := 0 if and(self.ACK, or(or(or(self.RST, not(self.CYC)), not(self.STB)), not(self.WE))); 1 if self.ACK\n[1] $monitor_mask_value_1#0_read := self.SEL if self.ACK\n[1] $monitor_addr_value_1#0_read := self.ADR if self.ACK\n[1] $monitor_live_4#0_read := 0 if and(self.ACK, or(or(or(self.RST, not(self.CYC)), not(self.STB)), self.WE)); 1 if self.ACK\n[1] $monitor_data_value_1#0_read := 0 if self.ACK"];
