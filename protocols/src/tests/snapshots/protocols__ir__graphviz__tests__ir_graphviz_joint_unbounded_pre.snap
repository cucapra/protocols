== unbounded-driver ==
digraph "id" {
  rankdir=LR;
  node [shape=box];
  entry_marker [shape=plain,label="ENTRY"];
  entry_marker -> node0;
  node0 [label="[not(transaction_valid)] done\n[1] DUT.a := X if not(and(transaction_valid, not(protocol_choice))); joint.a#0_id if and(transaction_valid, not(protocol_choice))\n[1] DUT.b := X if 1"];
  node0 -> node1 [label="and(transaction_valid, not(protocol_choice)) / step"];
  node0 -> node2 [label="and(not(DUT.ready), and(transaction_valid, protocol_choice)) / step"];
  node0 -> node0 [label="and(DUT.ready, and(transaction_valid, protocol_choice)) / step / R_w"];
  node1 [label="[1] DUT.a := X if not(and(transaction_valid, not(protocol_choice))); joint.a#1_id if and(transaction_valid, not(protocol_choice))\n[1] DUT.b := X if 1"];
  node1 -> node3 [label="not(transaction_valid) / step"];
  node1 -> node4 [label="and(transaction_valid, not(protocol_choice)) / step"];
  node1 -> node5 [label="and(not(DUT.ready), and(transaction_valid, protocol_choice)) / step"];
  node1 -> node6 [label="and(DUT.ready, and(transaction_valid, protocol_choice)) / step / R_w"];
  node2 [label="[1] DUT.a := X if 1\n[1] DUT.b := X if 1"];
  node2 -> node0 [label="DUT.ready / step / R_w"];
  node2 -> node2 [label="not(DUT.ready) / step"];
  node3 [label="[1] DUT.a := X if 1\n[1] DUT.b := X if 1\n[1] assert_eq(DUT.aout, joint.a#0_id)"];
  node3 -> node7 [label="1 / step / R_id"];
  node4 [label="[1] DUT.a := X if not(and(transaction_valid, not(protocol_choice))); joint.a#2_id if and(transaction_valid, not(protocol_choice))\n[1] DUT.b := X if 1\n[1] assert_eq(DUT.aout, joint.a#0_id)"];
  node4 -> node3 [label="not(transaction_valid) / step / R_id"];
  node4 -> node4 [label="and(transaction_valid, not(protocol_choice)) / step / R_id"];
  node4 -> node5 [label="and(not(DUT.ready), and(transaction_valid, protocol_choice)) / step / R_id"];
  node4 -> node6 [label="and(DUT.ready, and(transaction_valid, protocol_choice)) / step / R_id, R_w"];
  node5 [label="[1] DUT.a := X if 1\n[1] DUT.b := X if 1\n[1] assert_eq(DUT.aout, joint.a#0_id)"];
  node5 -> node0 [label="DUT.ready / step / R_id, R_w"];
  node5 -> node2 [label="not(DUT.ready) / step / R_id"];
  node6 [label="[1] DUT.a := X if not(and(transaction_valid, not(protocol_choice))); joint.a#1_id if and(transaction_valid, not(protocol_choice))\n[1] DUT.b := X if 1\n[1] assert_eq(DUT.aout, joint.a#0_id)"];
  node6 -> node7 [label="not(transaction_valid) / step / R_id"];
  node6 -> node1 [label="and(transaction_valid, not(protocol_choice)) / step / R_id"];
  node6 -> node2 [label="and(not(DUT.ready), and(transaction_valid, protocol_choice)) / step / R_id"];
  node6 -> node0 [label="and(DUT.ready, and(transaction_valid, protocol_choice)) / step / R_id, R_w"];
  node7 [label="[1] done\n[1] DUT.a := X if 1\n[1] DUT.b := X if 1"];
}

== unbounded-monitor ==
digraph "id" {
  rankdir=LR;
  node [shape=box];
  entry_marker [shape=plain,label="ENTRY"];
  entry_marker -> node0;
  node0 [label="[1] done\n[1] $monitor_a_value#0_id := DUT.a if 1\n[1] $monitor_live#0_id := 1 if 1\n[1] $monitor_live_1#0_w := 1 if 1\n[1] $monitor_b_value#0_w := 0 if 1"];
  node0 -> node1 [label="$monitor_live#0_id / step"];
  node0 -> node2 [label="and(not(DUT.ready), $monitor_live_1#0_w) / step"];
  node0 -> node0 [label="and(DUT.ready, $monitor_live_1#0_w) / step / R_w"];
  node0 -> node8 [label="not(or($monitor_live#0_id, $monitor_live_1#0_w)) / step"];
  node1 [label="[1] $monitor_live#0_id := $monitor_live#0_id if 1\n[1] $monitor_a_value#1_id := DUT.a if 1\n[1] $monitor_live#1_id := 1 if 1\n[1] $monitor_live_1#0_w := 1 if 1\n[1] $monitor_b_value#0_w := 0 if 1"];
  node1 -> node4 [label="and($monitor_live#0_id, $monitor_live#1_id) / step"];
  node1 -> node5 [label="and(not(DUT.ready), and($monitor_live#0_id, $monitor_live_1#0_w)) / step"];
  node1 -> node6 [label="and(DUT.ready, and($monitor_live#0_id, $monitor_live_1#0_w)) / step / R_w"];
  node1 -> node8 [label="not(and($monitor_live#0_id, or($monitor_live#1_id, $monitor_live_1#0_w))) / step"];
  node2 [label="[1] $monitor_live_1#0_w := $monitor_live_1#0_w if 1"];
  node2 -> node0 [label="and(DUT.ready, $monitor_live_1#0_w) / step / R_w"];
  node2 -> node2 [label="and(not(DUT.ready), $monitor_live_1#0_w) / step"];
  node2 -> node8 [label="not($monitor_live_1#0_w) / step"];
  node8 [label="BAD STATE"];
  node8 -> node8 [label="1 / step"];
  node4 [label="[1] $monitor_live#0_id := 0 if not(eq($monitor_a_value#0_id, DUT.aout)); $monitor_live#0_id if 1\n[1] $monitor_live#1_id := $monitor_live#1_id if 1\n[1] $monitor_a_value#2_id := DUT.a if 1\n[1] $monitor_live#2_id := 1 if 1\n[1] $monitor_live_1#0_w := 1 if 1\n[1] $monitor_b_value#0_w := 0 if 1"];
  node4 -> node4 [label="and(and($monitor_live#0_id, $monitor_live#1_id), $monitor_live#2_id) / step / R_id"];
  node4 -> node5 [label="and(not(DUT.ready), and(and($monitor_live#0_id, $monitor_live#1_id), $monitor_live_1#0_w)) / step / R_id"];
  node4 -> node6 [label="and(DUT.ready, and(and($monitor_live#0_id, $monitor_live#1_id), $monitor_live_1#0_w)) / step / R_id, R_w"];
  node4 -> node8 [label="not(and(and($monitor_live#0_id, $monitor_live#1_id), or($monitor_live#2_id, $monitor_live_1#0_w))) / step"];
  node5 [label="[1] $monitor_live#0_id := 0 if not(eq($monitor_a_value#0_id, DUT.aout)); $monitor_live#0_id if 1\n[1] $monitor_live_1#0_w := $monitor_live_1#0_w if 1"];
  node5 -> node0 [label="and(DUT.ready, and($monitor_live#0_id, $monitor_live_1#0_w)) / step / R_id, R_w"];
  node5 -> node2 [label="and(not(DUT.ready), and($monitor_live#0_id, $monitor_live_1#0_w)) / step / R_id"];
  node5 -> node8 [label="not(and($monitor_live#0_id, $monitor_live_1#0_w)) / step"];
  node6 [label="[1] $monitor_live#0_id := 0 if not(eq($monitor_a_value#0_id, DUT.aout)); $monitor_live#0_id if 1\n[1] $monitor_a_value#1_id := DUT.a if 1\n[1] $monitor_live#1_id := 1 if 1\n[1] $monitor_live_1#0_w := 1 if 1\n[1] $monitor_b_value#0_w := 0 if 1"];
  node6 -> node1 [label="and($monitor_live#0_id, $monitor_live#1_id) / step / R_id"];
  node6 -> node2 [label="and(not(DUT.ready), and($monitor_live#0_id, $monitor_live_1#0_w)) / step / R_id"];
  node6 -> node0 [label="and(DUT.ready, and($monitor_live#0_id, $monitor_live_1#0_w)) / step / R_id, R_w"];
  node6 -> node8 [label="not(and($monitor_live#0_id, or($monitor_live#1_id, $monitor_live_1#0_w))) / step"];
}
