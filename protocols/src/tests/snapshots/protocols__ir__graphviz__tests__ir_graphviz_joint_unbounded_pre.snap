== unbounded-driver ==
digraph "id" {
  rankdir=LR;
  node [shape=box];
  entry_marker [shape=plain,label="ENTRY"];
  entry_marker -> node0;
  node0 [label="[not(transaction_valid)] done\n[1] DUT.a := X if not(and(transaction_valid, not(protocol_choice))); joint.a#0_id if and(transaction_valid, not(protocol_choice))\n[1] DUT.b := X if 1"];
  node0 -> node1 [label="and(transaction_valid, not(protocol_choice)) / step"];
  node0 -> node2 [label="and(and(transaction_valid, protocol_choice), not(DUT.ready)) / step"];
  node0 -> node0 [label="and(and(transaction_valid, protocol_choice), DUT.ready) / step / R_w"];
  node1 [label="[1] DUT.a := X if not(and(transaction_valid, not(protocol_choice))); joint.a#1_id if and(transaction_valid, not(protocol_choice))\n[1] DUT.b := X if 1"];
  node1 -> node3 [label="not(transaction_valid) / step"];
  node1 -> node4 [label="and(transaction_valid, not(protocol_choice)) / step"];
  node1 -> node5 [label="and(and(transaction_valid, protocol_choice), not(DUT.ready)) / step"];
  node1 -> node6 [label="and(and(transaction_valid, protocol_choice), DUT.ready) / step / R_w"];
  node2 [label="[1] DUT.a := X if 1\n[1] DUT.b := X if 1"];
  node2 -> node0 [label="DUT.ready / step / R_w"];
  node2 -> node2 [label="not(DUT.ready) / step"];
  node3 [label="[1] DUT.a := X if 1\n[1] DUT.b := X if 1\n[1] assert_eq(DUT.aout, joint.a#0_id)"];
  node3 -> node7 [label="1 / step / R_id"];
  node4 [label="[1] DUT.a := X if not(and(transaction_valid, not(protocol_choice))); joint.a#2_id if and(transaction_valid, not(protocol_choice))\n[1] DUT.b := X if 1\n[1] assert_eq(DUT.aout, joint.a#0_id)"];
  node4 -> node3 [label="not(transaction_valid) / step / R_id"];
  node4 -> node4 [label="and(transaction_valid, not(protocol_choice)) / step / R_id"];
  node4 -> node5 [label="and(and(transaction_valid, protocol_choice), not(DUT.ready)) / step / R_id"];
  node4 -> node6 [label="and(and(transaction_valid, protocol_choice), DUT.ready) / step / R_id, R_w"];
  node5 [label="[1] DUT.a := X if 1\n[1] DUT.b := X if 1\n[1] assert_eq(DUT.aout, joint.a#0_id)"];
  node5 -> node0 [label="DUT.ready / step / R_id, R_w"];
  node5 -> node2 [label="not(DUT.ready) / step / R_id"];
  node6 [label="[1] DUT.a := X if not(and(transaction_valid, not(protocol_choice))); joint.a#1_id if and(transaction_valid, not(protocol_choice))\n[1] DUT.b := X if 1\n[1] assert_eq(DUT.aout, joint.a#0_id)"];
  node6 -> node7 [label="not(transaction_valid) / step / R_id"];
  node6 -> node1 [label="and(transaction_valid, not(protocol_choice)) / step / R_id"];
  node6 -> node2 [label="and(and(transaction_valid, protocol_choice), not(DUT.ready)) / step / R_id"];
  node6 -> node0 [label="and(and(transaction_valid, protocol_choice), DUT.ready) / step / R_id, R_w"];
  node7 [label="[1] done\n[1] DUT.a := X if 1\n[1] DUT.b := X if 1"];
}

