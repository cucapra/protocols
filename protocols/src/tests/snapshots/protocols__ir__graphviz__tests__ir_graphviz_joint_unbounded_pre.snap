  node0 [label="[not(transaction_valid)] done\n[1] $monitor_a_value#0_id := DUT.a if and(transaction_valid, not(protocol_choice))\n[1] $monitor_live#0_id := 1 if and(transaction_valid, not(protocol_choice))\n[1] $monitor_b_value#0_w := 0 if and(transaction_valid, protocol_choice)\n[1] $monitor_live_1#0_w := 1 if and(transaction_valid, protocol_choice)"];
