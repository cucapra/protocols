  node4 [label="[1] assert_eq($monitor_a_value#0_id, DUT.aout)\n[1] $monitor_a_value#2_id := DUT.a if and(transaction_valid, not(protocol_choice))\n[1] $monitor_live#2_id := 1 if and(transaction_valid, not(protocol_choice))\n[1] $monitor_b_value#0_w := 0 if and(transaction_valid, protocol_choice)\n[1] $monitor_live_1#0_w := 1 if and(transaction_valid, protocol_choice)"];
  node4 -> node3 [label="not(transaction_valid) / step / R_id"];
  node4 -> node4 [label="and(transaction_valid, not(protocol_choice)) / step / R_id"];
  node4 -> node5 [label="and(and(transaction_valid, protocol_choice), not(DUT.ready)) / step / R_id"];
