  node6 [label="[1] assert_eq($monitor_a_value#0_id, DUT.aout)\n[1] $monitor_a_value#1_id := DUT.a if and(transaction_valid, not(protocol_choice))\n[1] $monitor_live#1_id := 1 if and(transaction_valid, not(protocol_choice))\n[1] $monitor_b_value#0_w := 0 if and(transaction_valid, protocol_choice)\n[1] $monitor_live_1#0_w := 1 if and(transaction_valid, protocol_choice)"];
  node6 -> node7 [label="not(transaction_valid) / step / R_id"];
  node6 -> node1 [label="and(transaction_valid, not(protocol_choice)) / step / R_id"];
