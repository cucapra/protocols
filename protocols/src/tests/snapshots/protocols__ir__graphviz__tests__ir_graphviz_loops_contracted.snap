digraph "specialized_waits" {
  rankdir=LR;
  node [shape=box];
  entry_marker [shape=plain,label="ENTRY\nl0: values"];
  entry_marker -> node0;
  node0 [label="[1] l0_data := l0.data() if or(and(l0.valid(), not(l0.last())), and(l0.valid(), l0.last()))\n[1] dut.data := l0.data() if or(and(l0.valid(), not(l0.last())), and(l0.valid(), l0.last())); 99\n[1] $previous_data := ite(or(and(l0.valid(), not(l0.last())), and(l0.valid(), l0.last())), l0.data(), 99)\n[1] dut.flag := X if not(or(and(and(l0.valid(), not(l0.last())), dut.ready), and(and(l0.valid(), l0.last()), dut.ready))); 0 if and(and(l0.valid(), not(l0.last())), dut.ready); 1 if and(and(l0.valid(), l0.last()), dut.ready)\n[1] $previous_flag := and(or(and(and(l0.valid(), not(l0.last())), dut.ready), and(and(l0.valid(), l0.last()), dut.ready)), and(and(l0.valid(), l0.last()), dut.ready))\n[1] $previous_flag_is_x := not(or(and(and(l0.valid(), not(l0.last())), dut.ready), and(and(l0.valid(), l0.last()), dut.ready)))"];
  node0 -> node1 [label="and(and(l0.valid(), not(l0.last())), not(dut.ready)) / step"];
  node0 -> node2 [label="and(and(l0.valid(), not(l0.last())), dut.ready) / step"];
  node0 -> node3 [label="and(and(l0.valid(), l0.last()), not(dut.ready)) / step"];
  node0 -> node4 [label="and(and(l0.valid(), l0.last()), dut.ready) / step"];
  node0 -> node5 [label="not(l0.valid()) / step"];
  node1 [label="[1] dut.data := l0_data\n[1] dut.flag := X if and(not(dut.ready), $previous_flag_is_x); 0 if dut.ready; 0 if not(or(dut.ready, $previous_flag_is_x))\n[1] $previous_flag_is_x := and(not(dut.ready), $previous_flag_is_x)"];
  node1 -> node1 [label="not(dut.ready) / step"];
  node1 -> node2 [label="dut.ready / step"];
  node2 [label="[1] assert_eq(l0_data, dut.echo)\n[1] l0_index := add(l0_index, 1)\n[not(l0.valid())] internal_assert_false\n[1] l0_data := l0.data() if or(and(l0.valid(), not(l0.last())), and(l0.valid(), l0.last()))\n[1] dut.data := l0.data() if or(and(l0.valid(), not(l0.last())), and(l0.valid(), l0.last())); add(l0_data, l0_index)\n[1] $previous_data := ite(or(and(l0.valid(), not(l0.last())), and(l0.valid(), l0.last())), l0.data(), add(l0_data, l0_index))\n[1] dut.flag := 0 if and(and(l0.valid(), not(l0.last())), dut.ready); 1 if and(and(l0.valid(), l0.last()), dut.ready); 0 if not(or(and(and(l0.valid(), not(l0.last())), dut.ready), and(and(l0.valid(), l0.last()), dut.ready)))\n[1] $previous_flag := and(and(l0.valid(), l0.last()), dut.ready)"];
  node2 -> node1 [label="and(and(l0.valid(), not(l0.last())), not(dut.ready)) / step"];
  node2 -> node2 [label="and(and(l0.valid(), not(l0.last())), dut.ready) / step"];
  node2 -> node3 [label="and(and(l0.valid(), l0.last()), not(dut.ready)) / step"];
  node2 -> node4 [label="and(and(l0.valid(), l0.last()), dut.ready) / step"];
  node3 [label="[1] dut.data := l0_data\n[1] dut.flag := X if and(not(dut.ready), $previous_flag_is_x); 1 if dut.ready; 0 if not(or(dut.ready, $previous_flag_is_x))\n[1] $previous_flag := dut.ready\n[1] $previous_flag_is_x := and(not(dut.ready), $previous_flag_is_x)"];
  node3 -> node3 [label="not(dut.ready) / step"];
  node3 -> node4 [label="dut.ready / step"];
  node4 [label="[1] assert_eq(l0_data, dut.echo)\n[1] dut.data := add(l0_data, l0_index)\n[1] $previous_data := add(l0_data, l0_index)\n[1] dut.flag := 1"];
  node4 -> node5 [label="1 / step"];
  node5 [label="[1] dut.data := $previous_data\n[1] dut.flag := X if $previous_flag_is_x; $previous_flag if not($previous_flag_is_x)"];
  node5 -> node6 [label="1 / step"];
  node6 [label="[1] done\n[1] dut.data := X\n[1] dut.flag := X\n[1] $previous_flag_is_x := 1"];
