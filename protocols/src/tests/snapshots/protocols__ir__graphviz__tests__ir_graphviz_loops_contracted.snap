  node2 [label="[not(l0.valid())] done\n[1] dut.data := X if not(l0.valid()); l0.data() if and(l0.valid(), dut.ready); add(l0.data(), 1) if and(l0.valid(), not(dut.ready))\n[1] $previous_data := ite(not(l0.valid()), $previous_data, ite(and(l0.valid(), dut.ready), l0.data(), ite(and(l0.valid(), not(dut.ready)), add(l0.data(), 1), $previous_data)))\n[1] dut.flag := X"];
  node2 -> node1 [label="l0.valid() / step"];
}

