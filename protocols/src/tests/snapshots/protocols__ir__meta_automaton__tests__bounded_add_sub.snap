  node2 [label=<A<SUB>0</SUB><SUP>(0)</SUP> ∧ E<SUP>(1)</SUP>>];
  node2 -> node3 [label=<select A>];
  node2 -> node5 [label=<select S>];
  node3 [label=<A<SUB>0</SUB><SUP>(0)</SUP> ∧ A<SUB>pre</SUB><SUP>(1)</SUP>>];
  node3 -> node4 [label=<A forks after 1>];
  node4 [label=<A<SUB>0</SUB><SUP>(1)</SUP>>];
  node5 [label=<A<SUB>0</SUB><SUP>(0)</SUP> ∧ S<SUB>pre</SUB><SUP>(1)</SUP>>];
  node5 -> node6 [label=<S forks after 1>];
  node6 [label=<S<SUB>0</SUB><SUP>(1)</SUP>>];
  node7 [label=<S<SUB>pre</SUB><SUP>(0)</SUP>>];
  node7 -> node8 [label=<S forks after 1>];
  node8 [label=<S<SUB>0</SUB><SUP>(0)</SUP> ∧ E<SUP>(1)</SUP>>];
  node8 -> node9 [label=<select A>];
  node8 -> node11 [label=<select S>];
  node9 [label=<S<SUB>0</SUB><SUP>(0)</SUP> ∧ A<SUB>pre</SUB><SUP>(1)</SUP>>];
  node9 -> node10 [label=<A forks after 1>];
  node10 [label=<A<SUB>0</SUB><SUP>(1)</SUP>>];
  node11 [label=<S<SUB>0</SUB><SUP>(0)</SUP> ∧ S<SUB>pre</SUB><SUP>(1)</SUP>>];
  node11 -> node12 [label=<S forks after 1>];
  node12 [label=<S<SUB>0</SUB><SUP>(1)</SUP>>];
}
