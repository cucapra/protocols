digraph "driver_meta" {
  rankdir=LR;
  node [shape=box];
  entry [shape=plain,label="ENTRY"];
  entry -> node0;
  node0 [label=<E<SUP>(0)</SUP>>];
  node0 -> node1 [label=<A forks after 1>];
  node0 -> node4 [label=<S forks after 1>];
  node1 [label=<A<SUB>0</SUB><SUP>(0)</SUP> ∧ E<SUP>(1)</SUP>>];
  node1 -> node2 [label=<A forks after 1>];
  node1 -> node3 [label=<S forks after 1>];
  node2 [label=<A<SUB>0</SUB><SUP>(1)</SUP>>];
  node3 [label=<S<SUB>0</SUB><SUP>(1)</SUP>>];
  node4 [label=<S<SUB>0</SUB><SUP>(0)</SUP> ∧ E<SUP>(1)</SUP>>];
  node4 -> node5 [label=<A forks after 1>];
  node4 -> node6 [label=<S forks after 1>];
  node5 [label=<A<SUB>0</SUB><SUP>(1)</SUP>>];
  node6 [label=<S<SUB>0</SUB><SUP>(1)</SUP>>];
}
