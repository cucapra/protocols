---
source: protocols/src/ir/meta_automaton.rs
expression: content
---
digraph "driver_meta" {
  rankdir=LR;
  node [shape=box];
  entry [shape=plain,label="ENTRY"];
  entry -> node0;
  node0 [label=<E<SUP>(0)</SUP>>];
  node0 -> node1 [label=<select ADD>];
  node0 -> node2 [label=<select SUB>];
  node1 [label=<ADD<SUB>pre</SUB><SUP>(0)</SUP>>];
  node1 -> node3 [label=<ADD forks after {1, 2}>];
  node2 [label=<SUB<SUB>pre</SUB><SUP>(0)</SUP>>];
  node2 -> node4 [label=<SUB forks after 1>];
  node3 [label=<ADD<SUB>1</SUB><SUP>(0)</SUP> ∧ E<SUP>(1)</SUP>>];
  node3 -> node5 [label=<select ADD>];
  node3 -> node6 [label=<select SUB>];
  node4 [label=<SUB<SUB>0</SUB><SUP>(0)</SUP> ∧ E<SUP>(1)</SUP>>];
  node4 -> node7 [label=<select ADD>];
  node4 -> node8 [label=<select SUB>];
  node5 [label=<ADD<SUB>1</SUB><SUP>(0)</SUP> ∧ ADD<SUB>pre</SUB><SUP>(1)</SUP>>];
  node5 -> node9 [label=<ADD forks after 1>];
  node5 -> node3 [label=<ADD forks after 2 / R<SUB>ADD</SUB>>];
  node6 [label=<ADD<SUB>1</SUB><SUP>(0)</SUP> ∧ SUB<SUB>pre</SUB><SUP>(1)</SUP>>];
  node6 -> node10 [label=<SUB forks after 1>];
  node7 [label=<SUB<SUB>0</SUB><SUP>(0)</SUP> ∧ ADD<SUB>pre</SUB><SUP>(1)</SUP>>];
  node7 -> node3 [label=<ADD forks after {1, 2} / R<SUB>ADD</SUB>>];
  node8 [label=<SUB<SUB>0</SUB><SUP>(0)</SUP> ∧ SUB<SUB>pre</SUB><SUP>(1)</SUP>>];
  node8 -> node4 [label=<SUB forks after 1 / R<SUB>SUB</SUB>>];
  node9 [label=<ADD<SUB>0</SUB><SUP>(0)</SUP> ∧ ADD<SUB>1</SUB><SUP>(1)</SUP> ∧ E<SUP>(2)</SUP>>];
  node9 -> node11 [label=<select ADD>];
  node9 -> node12 [label=<select SUB>];
  node10 [label=<ADD<SUB>0</SUB><SUP>(0)</SUP> ∧ SUB<SUB>0</SUB><SUP>(1)</SUP> ∧ E<SUP>(2)</SUP>>];
  node10 -> node13 [label=<select ADD>];
  node10 -> node14 [label=<select SUB>];
  node11 [label=<ADD<SUB>0</SUB><SUP>(0)</SUP> ∧ ADD<SUB>1</SUB><SUP>(1)</SUP> ∧ ADD<SUB>pre</SUB><SUP>(2)</SUP>>];
  node11 -> node9 [label=<ADD forks after 1 / R<SUB>ADD</SUB>>];
  node11 -> node3 [label=<ADD forks after 2 / R<SUB>ADD</SUB><SUP>2</SUP>>];
  node12 [label=<ADD<SUB>0</SUB><SUP>(0)</SUP> ∧ ADD<SUB>1</SUB><SUP>(1)</SUP> ∧ SUB<SUB>pre</SUB><SUP>(2)</SUP>>];
  node12 -> node10 [label=<SUB forks after 1 / R<SUB>ADD</SUB>, R<SUB>SUB</SUB>>];
  node13 [label=<ADD<SUB>0</SUB><SUP>(0)</SUP> ∧ SUB<SUB>0</SUB><SUP>(1)</SUP> ∧ ADD<SUB>pre</SUB><SUP>(2)</SUP>>];
  node13 -> node3 [label=<ADD forks after {1, 2} / R<SUB>ADD</SUB><SUP>2</SUP>>];
  node14 [label=<ADD<SUB>0</SUB><SUP>(0)</SUP> ∧ SUB<SUB>0</SUB><SUP>(1)</SUP> ∧ SUB<SUB>pre</SUB><SUP>(2)</SUP>>];
  node14 -> node4 [label=<SUB forks after 1>];
}
