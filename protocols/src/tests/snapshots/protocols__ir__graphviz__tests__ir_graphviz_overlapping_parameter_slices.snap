  node1 [label="[1] done\n[1] DUT.a := X if 1; $previous_a if 0\n[1] $previous_a := $previous_a if 1\n[1] $previous_a_is_x := 1 if 1\n[1] DUT.b := X if 1; $previous_b if 0\n[1] $previous_b := $previous_b if 1\n[1] $previous_b_is_x := 1 if 1"];
}

