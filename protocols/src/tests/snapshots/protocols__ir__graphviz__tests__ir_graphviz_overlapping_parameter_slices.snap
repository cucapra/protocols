== post-contract ==
digraph "overlap" {
  rankdir=LR;
  node [shape=box];
  entry_marker [shape=plain,label="ENTRY"];
  entry_marker -> node0;
  node0 [label="[1] DUT.a := p[3:1]\n[1] $previous_a := ite(1, p[3:1], $previous_a); ite(1, $previous_a, $previous_a)\n[1] $previous_a_is_x := ite(0, 1, ite(1, 0, 1)); ite(1, 1, ite(0, 0, $previous_a_is_x))\n[1] DUT.b := p[4:2]\n[1] $previous_b := ite(1, p[4:2], $previous_b); ite(1, $previous_b, $previous_b)\n[1] $previous_b_is_x := ite(0, 1, ite(1, 0, 1)); ite(1, 1, ite(0, 0, $previous_b_is_x))"];
  node0 -> node2 [label="1 / step"];
  node2 [label="[1] DUT.a := X; $previous_a if not($previous_a_is_x)\n[1] DUT.b := X; $previous_b if not($previous_b_is_x)\n[1] done\n[1] $previous_a := ite(1, $previous_a, $previous_a)\n[1] $previous_a_is_x := ite(1, 1, ite(0, 0, $previous_a_is_x))\n[1] $previous_b := ite(1, $previous_b, $previous_b)\n[1] $previous_b_is_x := ite(1, 1, ite(0, 0, $previous_b_is_x))"];
}

