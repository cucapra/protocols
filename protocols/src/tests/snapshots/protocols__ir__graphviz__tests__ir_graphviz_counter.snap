digraph "count_up" {
  rankdir=LR;
  node [shape=box];
  entry_marker [shape=plain,label="ENTRY"];
  entry_marker -> node0;
  node0 [label="[1] dut.a := a\n[1] $previous_a := ite(1, a, $previous_a); ite(1, $previous_a, $previous_a)\n[1] $previous_a_is_x := ite(0, 1, ite(1, 0, 1)); ite(1, 1, ite(0, 0, $previous_a_is_x))"];
  node0 -> node10 [label="not(eq(dut.s, a)) / step"];
  node0 -> node6 [label="eq(dut.s, a) / step"];
  node10 [label="[1] dut.a := X if $previous_a_is_x; $previous_a if not($previous_a_is_x)"];
  node10 -> node10 [label="not(eq(dut.s, ite($previous_a_is_x, X, ite(not($previous_a_is_x), $previous_a, dut.a)))) / step"];
  node10 -> node6 [label="eq(dut.s, ite($previous_a_is_x, X, ite(not($previous_a_is_x), $previous_a, dut.a))) / step"];
  node6 [label="[1] dut.a := X if $previous_a_is_x; $previous_a if not($previous_a_is_x)\n[1] assert_eq(dut.s, 0)\n[1] fork"];
  node6 -> node2 [label="1 / step"];
  node2 [label="[1] dut.a := X; $previous_a if not($previous_a_is_x)\n[1] done\n[1] $previous_a := ite(1, $previous_a, $previous_a)\n[1] $previous_a_is_x := ite(1, 1, ite(0, 0, $previous_a_is_x))"];
}

