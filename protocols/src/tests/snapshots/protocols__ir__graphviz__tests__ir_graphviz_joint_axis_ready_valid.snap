---
source: protocols/src/ir/graphviz.rs
expression: content
---
== unbounded-driver ==
digraph "send_data" {
  rankdir=LR;
  node [shape=box];
  entry_marker [shape=plain,label="ENTRY"];
  entry_marker -> node0;
  node0 [label="[not(transaction_valid)] done\n[1] D.m_axis_tvalid := X if not(or(and(transaction_valid, not(protocol_choice)), and(transaction_valid, protocol_choice))); 1 if and(transaction_valid, not(protocol_choice)); 0 if and(transaction_valid, protocol_choice)\n[1] D.m_axis_tdata := X if not(and(transaction_valid, not(protocol_choice))); joint.data#0_send_data if and(transaction_valid, not(protocol_choice))"];
  node0 -> node1 [label="and(not(D.m_axis_tready), and(transaction_valid, not(protocol_choice))) / step"];
  node0 -> node0 [label="and(D.m_axis_tready, and(transaction_valid, not(protocol_choice))) / step / R_send_data"];
  node0 -> node0 [label="and(transaction_valid, protocol_choice) / step / R_idle"];
  node1 [label="[1] D.m_axis_tvalid := 1 if 1\n[1] D.m_axis_tdata := joint.data#0_send_data if 1"];
  node1 -> node0 [label="D.m_axis_tready / step / R_send_data"];
  node1 -> node1 [label="not(D.m_axis_tready) / step"];
}

== unbounded-monitor ==
digraph "send_data" {
  rankdir=LR;
  node [shape=box];
  entry_marker [shape=plain,label="ENTRY"];
  entry_marker -> node0;
  node0 [label="[1] done\n[1] $monitor_data_value#0_send_data := D.m_axis_tdata if 1\n[1] $monitor_live#0_send_data := 0 if not(D.m_axis_tvalid); 1 if 1\n[1] $monitor_live_1#0_idle := 0 if D.m_axis_tvalid; 1 if 1"];
  node0 -> node1 [label="and(not(D.m_axis_tready), $monitor_live#0_send_data) / step"];
  node0 -> node0 [label="and(D.m_axis_tready, $monitor_live#0_send_data) / step / R_send_data"];
  node0 -> node0 [label="$monitor_live_1#0_idle / step / R_idle"];
  node0 -> node2 [label="not(or($monitor_live#0_send_data, $monitor_live_1#0_idle)) / step"];
  node1 [label="[1] $monitor_live#0_send_data := 0 if not(and(D.m_axis_tvalid, eq($monitor_data_value#0_send_data, D.m_axis_tdata))); $monitor_live#0_send_data if 1"];
  node1 -> node0 [label="and(D.m_axis_tready, $monitor_live#0_send_data) / step / R_send_data"];
  node1 -> node1 [label="and(not(D.m_axis_tready), $monitor_live#0_send_data) / step"];
  node1 -> node2 [label="not($monitor_live#0_send_data) / step"];
  node2 [label="BAD STATE"];
  node2 -> node2 [label="1 / step"];
}
