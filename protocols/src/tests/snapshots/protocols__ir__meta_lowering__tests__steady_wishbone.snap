digraph "reset" {
  rankdir=LR;
  node [shape=box];
  entry_marker [shape=plain,label="ENTRY"];
  entry_marker -> node0;
  node0 [label="[eq(node_choice, 3)] assert_eq(mask#0_write, 15)\n[eq(node_choice, 4)] assert_eq(mask#0_read, 15)\n[and(eq(node_choice, 4), self.ACK)] assert_eq(self.DAT_I, data#0_read)\n[1] self.RST := 1 if eq(node_choice, 0); 0 if or(and(ge(node_choice, 1), not(ge(node_choice, 3))), and(ge(node_choice, 3), not(ge(node_choice, 5))))\n[1] self.ADR := X if not(ge(node_choice, 3)); addr#0_write if eq(node_choice, 3); addr#0_read if eq(node_choice, 4)\n[1] self.CYC := 0 if not(ge(node_choice, 2)); 1 if or(and(ge(node_choice, 2), not(ge(node_choice, 4))), eq(node_choice, 4))\n[1] self.DAT_O := X if or(not(ge(node_choice, 3)), eq(node_choice, 4)); data#0_write if eq(node_choice, 3)\n[1] self.SEL := X if not(ge(node_choice, 3)); mask#0_write if eq(node_choice, 3); mask#0_read if eq(node_choice, 4)\n[1] self.STB := X if eq(node_choice, 1); 0 if or(eq(node_choice, 0), eq(node_choice, 2)); 1 if and(ge(node_choice, 3), not(ge(node_choice, 5)))\n[1] self.WE := X if not(ge(node_choice, 3)); 1 if eq(node_choice, 3); 0 if eq(node_choice, 4)\n[1] self.BTE := X if not(ge(node_choice, 5))\n[1] self.CTI := X if not(ge(node_choice, 3)); 0 if and(ge(node_choice, 3), not(ge(node_choice, 5)))"];
  node0 -> node0 [label="eq(node_choice, 0) / step"];
  node0 -> node0 [label="eq(node_choice, 1) / step"];
  node0 -> node0 [label="eq(node_choice, 2) / step"];
  node0 -> node0 [label="and(eq(node_choice, 3), self.ACK) / step"];
  node0 -> node1 [label="and(eq(node_choice, 3), not(self.ACK)) / step"];
  node0 -> node0 [label="and(eq(node_choice, 4), self.ACK) / step"];
  node0 -> node2 [label="and(eq(node_choice, 4), not(self.ACK)) / step"];
  node1 [label=""];
  node1 -> node0 [label="self.ACK / step"];
  node1 -> node1 [label="not(self.ACK) / step"];
  node2 [label="[self.ACK] assert_eq(self.DAT_I, data#0_read)"];
  node2 -> node0 [label="self.ACK / step"];
  node2 -> node2 [label="not(self.ACK) / step"];
}
