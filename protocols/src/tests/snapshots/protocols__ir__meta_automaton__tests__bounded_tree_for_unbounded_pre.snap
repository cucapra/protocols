---
source: protocols/src/ir/meta_automaton.rs
expression: content
---
digraph "driver_meta" {
  rankdir=LR;
  node [shape=box];
  entry [shape=plain,label="ENTRY"];
  entry -> node0;
  node0 [label=<E<SUP>(0)</SUP>>];
  node0 -> node1 [label=<select ADD>];
  node0 -> node8 [label=<select WAIT>];
  node1 [label=<ADD<SUB>pre</SUB><SUP>(0)</SUP>>];
  node1 -> node2 [label=<ADD forks after 1>];
  node2 [label=<ADD<SUB>1</SUB><SUP>(0)</SUP> ∧ E<SUP>(1)</SUP>>];
  node2 -> node3 [label=<select ADD>];
  node2 -> node5 [label=<select WAIT>];
  node3 [label=<ADD<SUB>1</SUB><SUP>(0)</SUP> ∧ ADD<SUB>pre</SUB><SUP>(1)</SUP>>];
  node3 -> node4 [label=<ADD forks after 1>];
  node4 [label=<ADD<SUB>0</SUB><SUP>(0)</SUP> ∧ ADD<SUB>1</SUB><SUP>(1)</SUP>>];
  node5 [label=<ADD<SUB>1</SUB><SUP>(0)</SUP> ∧ WAIT<SUB>pre</SUB><SUP>(1)</SUP>>];
  node5 -> node6 [label=<WAIT forks after 1>];
  node5 -> node7 [label=<WAIT forks after ≥2>];
  node6 [label=<ADD<SUB>0</SUB><SUP>(0)</SUP> ∧ WAIT<SUB>0</SUB><SUP>(1)</SUP>>];
  node7 [label=<WAIT<SUB>0</SUB><SUP>(1)</SUP>>];
  node8 [label=<WAIT<SUB>pre</SUB><SUP>(0)</SUP>>];
  node8 -> node9 [label=<WAIT forks after ≥1>];
  node9 [label=<WAIT<SUB>0</SUB><SUP>(0)</SUP> ∧ E<SUP>(1)</SUP>>];
  node9 -> node10 [label=<select ADD>];
  node9 -> node12 [label=<select WAIT>];
  node10 [label=<WAIT<SUB>0</SUB><SUP>(0)</SUP> ∧ ADD<SUB>pre</SUB><SUP>(1)</SUP>>];
  node10 -> node11 [label=<ADD forks after 1>];
  node11 [label=<ADD<SUB>1</SUB><SUP>(1)</SUP>>];
  node12 [label=<WAIT<SUB>0</SUB><SUP>(0)</SUP> ∧ WAIT<SUB>pre</SUB><SUP>(1)</SUP>>];
  node12 -> node13 [label=<WAIT forks after ≥1>];
  node13 [label=<WAIT<SUB>0</SUB><SUP>(1)</SUP>>];
}
