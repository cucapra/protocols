---
source: protocols/src/ir/meta_automaton.rs
expression: content
---
digraph "driver_meta" {
  rankdir=LR;
  node [shape=box];
  entry [shape=plain,label="ENTRY"];
  entry -> node0;
  node0 [label=<E<SUP>(0)</SUP>>];
  node0 -> node1 [label=<ADD forks>];
  node0 -> node2 [label=<WAIT forks>];
  node0 -> node3 [label=<WAIT continues>];
  node1 [label=<ADD<SUB>1</SUB><SUP>(0)</SUP> ∧ E<SUP>(1)</SUP>>];
  node1 -> node4 [label=<ADD forks>];
  node1 -> node5 [label=<WAIT forks>];
  node1 -> node6 [label=<WAIT continues>];
  node2 [label=<WAIT<SUB>0</SUB><SUP>(0)</SUP> ∧ E<SUP>(1)</SUP>>];
  node2 -> node1 [label=<ADD forks / R<SUB>ADD</SUB>>];
  node2 -> node2 [label=<WAIT forks / R<SUB>WAIT</SUB>>];
  node2 -> node3 [label=<WAIT continues / R<SUB>WAIT</SUB>>];
  node3 [label=<WAIT<SUB>pre[1]</SUB><SUP>(0)</SUP>>];
  node3 -> node2 [label=<WAIT forks>];
  node3 -> node3 [label=<WAIT continues>];
  node4 [label=<ADD<SUB>0</SUB><SUP>(0)</SUP> ∧ ADD<SUB>1</SUB><SUP>(1)</SUP> ∧ E<SUP>(2)</SUP>>];
  node4 -> node4 [label=<ADD forks / R<SUB>ADD</SUB>>];
  node4 -> node5 [label=<WAIT forks / R<SUB>ADD</SUB>, R<SUB>WAIT</SUB>>];
  node4 -> node6 [label=<WAIT continues / R<SUB>ADD</SUB>, R<SUB>WAIT</SUB>>];
  node5 [label=<ADD<SUB>0</SUB><SUP>(0)</SUP> ∧ WAIT<SUB>0</SUB><SUP>(1)</SUP> ∧ E<SUP>(2)</SUP>>];
  node5 -> node1 [label=<ADD forks / R<SUB>ADD</SUB><SUP>2</SUP>>];
  node5 -> node2 [label=<WAIT forks / R<SUB>WAIT</SUB><SUP>2</SUP>>];
  node5 -> node3 [label=<WAIT continues / R<SUB>WAIT</SUB><SUP>2</SUP>>];
  node6 [label=<ADD<SUB>0</SUB><SUP>(0)</SUP> ∧ WAIT<SUB>pre[1]</SUB><SUP>(1)</SUP>>];
  node6 -> node2 [label=<WAIT forks / R<SUB>WAIT</SUB>>];
  node6 -> node3 [label=<WAIT continues / R<SUB>WAIT</SUB>>];
}
