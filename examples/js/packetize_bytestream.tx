trace {
    reset();
    // Note: the DUT (a Xilinx AXI-Stream manager demo core) is hard-coded to only transmit `tdata = 1,2,...8` across 8 beats,
    // where each `tdata` is a 32-bit word (4 bytes), where the low-order bytes are sent first,
    // i.e., each group of 4 consecutive elements in the sequence below corresponds to a byte, where the earlier 
    // elements correspond to lower order bytes
    packetize_bytestream([1, 0, 0, 0, 2, 0, 0, 0, 3, 0, 0, 0, 4, 0, 0, 0, 5, 0, 0, 0, 6, 0, 0, 0, 7, 0, 0, 0, 8, 0, 0, 0]);
}
