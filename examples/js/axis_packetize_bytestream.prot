struct Axis {
  in aresetn: u1,
  in tready: u1,

  out tvalid: u1,
  // Data is 32-bits, but is broken up into bytes and transfered via packets consisting of multiple bytes
  out tdata: u32,
  out tkeep: u4,
  out tstrb: u4,

  // Indicates if a transfer represents the end of a packet 
  out tlast: u1, 
}

prot reset<DUT: Axis>() {
  // Reset is active-low
  DUT.aresetn := 1'b0;
  step();
}

// Converts a bytestream (non-empty sequence of bytes) into AXI-Stream transfers, 
// where each transfer has a 32-bit `tdata` payload (4 bytes)
prot packetize_bytestream<DUT: Axis>(bytes: [u8]+) {
  DUT.aresetn := 1'b1;  // Active-low reset
  DUT.tready := 1'b1;   // No backpressure 

  for byte in bytes {
    // Wait until DUT indicates there's valid data
    while !(DUT.tvalid == 1'b1) {
      step();
    }

    // Assemble the appropriate byte of `tdata`
    // Note: `iter_count::<u2>()` truncates it to the lowest 2 bits,
    // which is equivalent to computing `iter_count % 4`.
    // AXIS spec (section 2.3.1): lower order bytes of `tdata` correspond
    // to earlier bytes in the bytestream
    if iter_count::<u2>() == 2'b00 {
      assert_eq(DUT.tdata[7:0], byte);
    } else {
      if iter_count::<u2>() == 2'b01 {
        assert_eq(DUT.tdata[15:8], byte);
      } else {
        if iter_count::<u2>() == 2'b10 {
          assert_eq(DUT.tdata[23:16], byte);
        } else {
          assert_eq(DUT.tdata[31:24], byte);
        }
      }
    }
    
    if is_last() {
      // Reached end of the `bytes` sequence 
      // (Assume this coincides with the end of a packet, as indicate by setting `tlast = 1`)
      assert_eq(DUT.tlast, 1'b1);

      // Compute `tkeep` appropriately based on the result of `iter_count % 4`
      // AXIS spec (section 2.4): `tkeep[i]` is associated with `tdata[(8*i+7):8*i]`,
      // and lower order bytes of `tdata` come earlier in the stream. 
      // Like above, we assume that `tkeep` and `tstrb` are the same for now.
      if iter_count::<u2>() == 2'b00 {
        assert_eq(DUT.tkeep, 4'b0001);
        assert_eq(DUT.tstrb, 4'b0001);  
      } else {
        if iter_count::<u2>() == 2'b01 {
          assert_eq(DUT.tkeep, 4'b0011);
          assert_eq(DUT.tstrb, 4'b0011);   
        } else {
          if iter_count::<u2>() == 2'b10 {
            assert_eq(DUT.tkeep, 4'b0111); 
            assert_eq(DUT.tstrb, 4'b0111);  
          } else {
            assert_eq(DUT.tkeep, 4'b1111);
            assert_eq(DUT.tstrb, 4'b1111);   
          }
        }
      }
      // One cycle for the data transfer
      step();

    } else {
      // Only perform data transfer once we've assembled all 4 bytes of `tdata`
      if iter_count::<u2>() == 2'b11 {
        assert_eq(DUT.tlast, 1'b0);
        assert_eq(DUT.tkeep, 4'b1111); 
        assert_eq(DUT.tstrb, 4'b1111);
        step();
      }
    }    
    // Note: if `iter_count % 4 != 3`, we just proceed to the next 
    // for-loop iteration without stepping 
  } 
}
