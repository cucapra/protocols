struct Axis {
  in aresetn: u1,
  in tready: u1,

  out tvalid: u1,
  // Data is 32-bits, but is broken up into bytes and transfered via packets consisting of multiple bytes
  out tdata: u32,
  out tkeep: u4,
  out tstrb: u4,

  // Indicates if a transfer represents the end of a packet 
  out tlast: u1, 
}

// `tkeep_last` represents "the tkeep for the last beat", 
// i.e. if `len(data) % 4 != 0`, then `tkeep` would represent what the last beat would be
// The body of this protocol would set `tkeep` to 1 for all the non-last beats
prot stream<DUT: Axis>(data: [u32]+, tkeep_last: u4) {
  DUT.aresetn := 1'b1;  // Active-low reset
  DUT.tready := 1'b1;  // Raphaell: No backpressure 

  for d in data {
    // Wait till DUT asserts there is valid data
    while (!(DUT.tvalid == 1'b1)) {
      step();
    }

    // Transmit tdata & tstrb
    assert_eq(DUT.tdata, d);

    // Assume we are only transmitting data bytes (i.e., tstrb is always 1s)
    assert_eq(DUT.tstrb, 4'b1111);    

    if !is_last() {
      assert_eq(DUT.tkeep, 4'b1111);
      assert_eq(DUT.tlast, 1'b0);
    } else {
      assert_eq(DUT.tkeep, tkeep_last);
      assert_eq(DUT.tlast, 1'b1);
    }

    step();
  }
}

// Converts a bytestream into an AXI-Stream transfer, 
// where each transfer has a 32-bit `tdata` payload (4 bytes)
prot packetize_bytestream<DUT: Axis>(bytes: [u8]+, tkeep_last: u4, end_of_packet: u1) {
  DUT.aresetn := 1'b1;  // Active-low reset
  DUT.tready := 1'b1;   // No backpressure 

  for byte in bytes {
    // Wait until DUT indicates there's valid data
    while !(DUT.tvalid == 1'b1) {
      step();
    }

    // Assemble the appropriate byte of `tdata`
    // Note: `iter_count::<u2>()` truncates it to the lowest 4 bits,
    // which is equivalent to computing `iter_count % 4`
    if iter_count::<u2>() == 2'b00 {
      assert_eq(DUT.tdata[7:0], byte);
    } else {
      if iter_count::<u2>() == 2'b01 {
        assert_eq(DUT.tdata[15:8], byte);
      } else {
        if iter_count::<u2>() == 2'b10 {
          assert_eq(DUT.tdata[23:16], byte);
        } else {
          assert_eq(DUT.tdata[31:24], byte);
        }
      }
    }
    
    if is_last() {
      // Reached end of the `bytes` sequence
      assert_eq(DUT.tlast, end_of_packet);
      assert_eq(DUT.tkeep, tkeep_last);
      assert_eq(DUT.tstrb, 4'b1111);  
      step();
    } else {
      // Only perform data transfer once we've assembled all 4 bytes of `tdata`, 
      if iter_count::<u2>() == 2'b11 {
        assert_eq(DUT.tlast, 1'b0);
        assert_eq(DUT.tkeep, 4'b1111); 
        assert_eq(DUT.tstrb, 4'b1111);
        step();
      }
    }    
    // Note: if `iter_count % 4 != 3`, we just proceed to the next 
    // for-loop iteration without stepping 
  } 
}