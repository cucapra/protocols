struct Axis {
    in aresetn: u1,
    in tready: u1,

    out tvalid: u1,
    // Data is 32-bits, but is broken up into bytes and transfered via packets consisting of multiple bytes
    out tdata: u32,
    out tkeep: u4,
    out tstrb: u4,
    out tlast: u1,
}

// `tkeep_last` is `bytes.len() % 4` in unary ("the last tkeep for the last chunk"), morally speaking
prot stream<...>(bytes: [u32]+, tkeep_last: u4) { ... }

prot stream'<...>(bytes_and_strb: [(u32, u4)]+, ...) { ... }

prot recv_stream<DUT: Axis>(bytes: [u8]+, tuser: u32, tkeep: [u4]+, tstrb: [u4]+) {
    DUT.aresetn := 1'b1;

    // Raphael: there is no backpressure
    DUT.tready := 1'b1;

    // Iterate over the `bytes` sequence in chunks of 4, with the last chunk possibly having length < 4
    for beat_bytes in bytes.chunks(4) {        
        while (!(DUT.tvalid == 1'b1)) {
            step();
        }
        
        // Construct a beat consisting of 4 bytes (note: `len()` returns a `uint`)
        if beat_bytes.len() == 4 {
            assert_eq(DUT.tdata[7:0], beat_bytes[0]);
            assert_eq(DUT.tdata[15:8], beat_bytes[1]);
            assert_eq(DUT.tdata[23:16], beat_bytes[2]); 
            assert_eq(DUT.tdata[31:24], beat_bytes[3]); 
        } else {
            // Handle the case when the final beat has < 4 bytes
            // (Bits of `tdata` that aren't constrained by `assert_eq` are DontCare)

            // Note: we flatten `... else { if ... }` into `else if`
            if beat_bytes.len() == 1 {
                assert_eq(DUT.tdata[7:0], beat_bytes[0]);
            } else if beat_bytes.len() == 2 {
                assert_eq(DUT.tdata[7:0], beat_bytes[0]);
                assert_eq(DUT.tdata[15:8], beat_bytes[1]);
            } else if beat_bytes.len() == 3 {
                assert_eq(DUT.tdata[7:0], beat_bytes[0]);
                assert_eq(DUT.tdata[15:8], beat_bytes[1]);
                assert_eq(DUT.tdata[23:16], beat_bytes[2]); 
            }
        }
            
        // Need some way to infer the bit-width of `iter_count`
        assert_eq(DUT.tkeep, tkeep[iter_count::<_>()]);
        assert_eq(DUT.tstrb, tstrb[iter_count::<?>()]);

        if is_last() {
            assert_eq(DUT.tlast, 1'b1);
        } else {
            assert_eq(DUT.tlast, 1'b0);
        }        

        step();
    }
}

