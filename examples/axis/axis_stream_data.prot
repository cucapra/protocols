struct Axis {
  in aresetn: u1,
  in tready: u1,

  out tvalid: u1,
  // Data is 32-bits, but is broken up into bytes and transfered via packets consisting of multiple bytes
  out tdata: u32,
  out tkeep: u4,
  out tstrb: u4,

  // Indicates if a transfer represents the end of a packet 
  out tlast: u1, 
}

prot reset<DUT: Axis>() {
  // Reset is active-low
  DUT.aresetn := 1'b0;
  step();
}

// No valid data on bus when idle
#[idle]
prot idle<DUT: Axis>() {
  DUT.aresetn := 1'b1;
  DUT.tready := 1'b0;
  assert_eq(DUT.tvalid, 1'b0);
  step();
}

// Transmits a sequence of `u32` data items via AXI-Stream 
// (where the end of the sequence represents the end of a packet, i.e. `tlast = 1` 
// when we reach the end of the sequence).
// `tkeep_last` represents "the tkeep for the last beat", 
// i.e. if `len(data) % 4 != 0`, then `tkeep` would represent what the last beat would be
// The body of this protocol would set `tkeep` to 1 for all the non-last beats
prot stream<DUT: Axis>(data: [u32]+, tkeep_last: u4) {
  DUT.aresetn := 1'b1;  // Active-low reset
  DUT.tready := 1'b1;  // Raphaell: No backpressure 

  for d in data {
    // Wait till DUT asserts there is valid data
    while (!(DUT.tvalid == 1'b1)) {
      step();
    }

    // Transmit tdata & tstrb
    assert_eq(DUT.tdata, d);


    // For simplicity, we assume `tstrb` is the same as `tkeep` 
    // (This is permitted per AXIS spec sections 2.4.3 & 3.1.2: 
    // and is equivalent to assuming that the input byte stream only contains
    // data bytes and not position bytes.)
    if !is_last() {
      assert_eq(DUT.tkeep, 4'b1111);
      assert_eq(DUT.tstrb, 4'b1111);   
      assert_eq(DUT.tlast, 1'b0);
    } else {
      assert_eq(DUT.tkeep, tkeep_last);
      assert_eq(DUT.tstrb, tkeep_last);
      assert_eq(DUT.tlast, 1'b1);
    }

    step();
  }
}