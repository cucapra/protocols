struct ALU {
  in a: u32,
  in b: u32,
  in op: u1,
  in go: u1,
  out done: u1,
  out s: u32,
}

prot add<DUT: ALU>(a: u32, b: u32, s: u32) {
  DUT.a := a;
  DUT.b := b;
  DUT.op := 1'b0;
  DUT.go := 1'b0;
  step();
  DUT.a := X;
  DUT.b := X;
  DUT.op := X;
  DUT.go := X;
  assert_eq(DUT.s, s);
  fork();
  step();
}

prot mul<DUT: ALU>(a: u32, b: u32, s: u32) {
  DUT.a := a;
  DUT.b := b;
  DUT.op := 1'b1;
  DUT.go := 1'b1;
  step();
  DUT.go := 1'b0;
  DUT.a := X;
  DUT.b := X;
  DUT.op := X;
  while !DUT.done {
    step();
  }
  assert_eq(DUT.s, s);
  step();
}
