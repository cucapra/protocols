// Pipelined Wishbone 4
// Note #1: pipelined and non-pipelined wishbone protocols cannot co-exit.
//          I.e., IP implementing pipelined wishbone is not compatible with IP implementing non-pipelined wishbone.
// Note #2: while the Wishbone spec allows pipelined burst transfers, we are not aware of any actual implementation
//          and thus do not specify burst protocols.
// Note #3: with the current protocol language (Aug 2026) we cannot model pipelined wishbone with both flexible delay
 //         and multiple concurrent transactions. There is no way to synchronize concurrent transaction such that
 //         the first transaction consumes the first ack signal. We decide to model only sequential transactions.
 //         Thus, our protocols do not fork until the ack signal is received.


// Wishbone pins for this project from the server (the one servicing requests) perspective
interface Wishbone {
    // high active RST pin (the wishbone spec requires all signals to be high active)
    in RST: u1,
    // acknowledge (from server)
    out ACK: u1,
    // address (from client)
    in ADR: u32,
    // cycle output, indicates bus cycle in progress (from client)
    in CYC: u1,
    // read data from server
    out DAT_I: u32,
    // write data from client
    in DAT_O: u32,
    // error from server
    out ERR: u1,
    // request to retry from server
    out RTY: u1,
    // mask for data in/out from client
    in SEL: u4,
    // indicates a valid transfer cycle from client
    in STB: u1,
    // write enable (i.e. not read) from client
    in WE: u1,
    // stall
    out STALL: u1,
}

prot reset<self: Wishbone>() {
    self.RST := 1'b1;
    self.CYC := 1'b0;
    self.STB := 1'b0;
    step();
}


#[idle]
prot idle_no_cycle<self: Wishbone>() {
    self.RST := 1'b0;
    self.CYC := 1'b0;
    step();
}

#[idle]
prot idle_continue_cycle<self: Wishbone>() {
    self.RST := 1'b0;
    self.CYC := 1'b1;
    self.STB := 1'b0;
    step();
}

prot write<self: Wishbone>(mask: u4, addr: u32, data: u32) {
    // no RST
    self.RST := 1'b0;
    // in our simple version, we always drive cyc and stb together
    self.CYC := 1'b1;
    self.STB := 1'b1;
    // we are writing
    self.WE := 1'b1;
    // apply parameters
    self.ADR := addr;
    self.SEL := mask;
    // TODO: masking
    self.DAT_O := data;


    // wait for device to be ready
    while self.STALL == 1'b1 {
      step();
    }

    // inputs need to be stable for 1 cycle while STALL is low
    step();

    // release inputs besides cyc
    self.STB := X;
    self.WE := X;
    self.ADR := X;
    self.SEL := X;
    self.DAT_O := X;

    // wait for ack
    while self.ACK == 1'b0 {
        step();
    }

    // acknowledge is now true
    fork();
    step();
}

prot read<self: Wishbone>(mask: u4, addr: u32, data: u32) {
    // no RST
    self.RST := 1'b0;
    // in our simple version, we always drive cyc and stb together
    self.CYC := 1'b1;
    self.STB := 1'b1;
    // we are reading
    self.WE := 1'b0;
    // apply parameters
    self.ADR := addr;
    self.SEL := mask;

    // wait for device to be ready
    while self.STALL == 1'b1 {
      step();
    }

    // inputs need to be stable for 1 cycle while STALL is low
    step();

    // release inputs besides cyc
    self.STB := X;
    self.WE := X;
    self.ADR := X;
    self.SEL := X;

    // wait for ack
    while self.ACK == 1'b0 {
        step();
    }

    // acknowledge is now true
    assert_eq(self.DAT_I, data); // TODO: mask
    fork();
    step();
}
