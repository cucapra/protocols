// Wishbone pins for this project from the server (the one servicing requests) perspective
interface Wishbone {
    // high active RST pin (the wishbone spec requires all signals to be high active)
    in RST: u1,
    // acknowledge (from server)
    out ACK: u1,
    // address (from client)
    in ADR: u32,
    // cycle output, indicates bus cycle in progress (from client)
    in CYC: u1,
    // read data from server
    out DAT_I: u32,
    // write data from client
    in DAT_O: u32,
    // error from server
    out ERR: u1,
    // mask for data in/out from client
    in SEL: u4,
    // indicates a valid transfer cycle from client
    in STB: u1,
    // write enable (i.e. not read) from client
    in WE: u1,
    // stall from client
    out STALL: u1,
    // no RTY
    // no LOCK
}

prot reset<self: Wishbone>() {
    self.RST := 1'b1;
    step();
    fork();
    self.CYC := 1'b0;
    self.STB := 1'b0;
    step();
}

#[idle]
prot idle_no_cycle<self: Wishbone>() {
    self.RST := 1'b0;
    self.CYC := 1'b0;
    step();
}

prot idle_continue_cycle<self: Wishbone>() {
    self.RST := 1'b0;
    self.CYC := 1'b1;
    self.STB := 1'b0;
    step();
}

prot write<self: Wishbone>(mask: u4, addr: u32, data: u32) {
    // no RST
    self.RST := 1'b0;
    // classic cycle (in which case bte is don't care)
    self.CTI := 3'b0;
    self.BTE := X;

    // in our simple version, we always drive cyc and stb together
    self.CYC := 1'b1;
    self.STB := 1'b1;

    // we are writing
    self.WE := 1'b1;

    // apply parameters
    self.ADR := addr;
    self.SEL := mask;
    self.DAT_O := data;

    // keep holding until STALL is low
    while self.STALL == 1'b0 {
        step();
    }

    // request has been made, so now drop STB and unconstrain the request pins
    self.STB := 1'b0;
    self.WE := X;
    self.ADR := X;
    self.SEL := X;
    self.DAT_O := X;

    // TODO: masking
    // if !mask[0] { DAT_O[ 7: 0] := X; }
    // if !mask[1] { DAT_O[15: 8] := X; }
    // if !mask[2] { DAT_O[23:16] := X; }
    // if !mask[3] { DAT_O[31:24] := X; }


    while self.ACK == 1'b0 || self.ERR == 1'b0 {
        step();
    }

    if self.ERR == 1'b1 {
        // if ERR, STALL also needs to be high
        assert_eq(self.STALL, 1'b1);
    }

    self.CYC := 1'b0; // to match the SVA?

    // acknowledge is now true
    step();
    // CYC is now unconstrained - Wishbone spec is okay with this, but the SVA requires
    // CYC to be dropped prior to this step();
}

prot read<self: Wishbone>(mask: u4, addr: u32, data: u32) {
    // no RST
    self.RST := 1'b0;
    // classic cycle (in which case bte is don't care)
    self.CTI := 3'b0;
    self.BTE := X;

    // in our simple version, we always drive cyc and stb together
    self.CYC := 1'b1;
    self.STB := 1'b1;

    // we are reading
    self.WE := 1'b0;

    // apply parameters
    self.ADR := addr;
    self.SEL := mask;
    self.DAT_O := X;

    // keep holding until STALL is low
    while self.STALL == 1'b0 {
        step();
    }

    // request has been made, so now drop STB and unconstrain the request pins
    self.STB := 1'b0;
    self.WE := X;
    self.ADR := X;
    self.SEL := X;
    self.DAT_O := X;

    while self.ACK == 1'b0 || self.ERR == 1'b0 {
        step();
    }

    if self.ERR == 1'b1 {
        // if ERR, STALL also needs to be high
        assert_eq(self.STALL, 1'b1);
    }

    self.CYC := 1'b0; // to match the SVA?

    // TODO: masking
    // if mask[0] { assert_eq(self.DAT_I[ 7: 0], data[ 7: 0]); }
    // if mask[1] { assert_eq(self.DAT_I[15: 8], data[15: 8]); }
    // if mask[2] { assert_eq(self.DAT_I[23:16], data[23:16]); }
    // if mask[3] { assert_eq(self.DAT_I[31:24], data[31:24]); }

    assert_eq(self.DAT_I, data);
    step();
}

#[idle]
prot idle_no_cycle<self: Wishbone>() {
    self.RST := 1'b0;
    self.CYC := 1'b0;
    step();
}

prot idle_continue_cycle<self: Wishbone>() {
    self.RST := 1'b0;
    self.CYC := 1'b1;
    self.STB := 1'b0;
    step();
}