struct Mux5 {
  in in0: u8,
  in in1: u8,
  in in2: u8,
  in in3: u8,
  in in4: u8,
  in sel: u3,
  out y: u8
}

prot zeroth<DUT: Mux5>(inputs: (u16, u32, u8, u64, u12), y: u8) {
  DUT.in0 := inputs.0[7:0];
  DUT.in1 := inputs.1[7:0];
  DUT.in2 := inputs.2[7:0];
  DUT.in3 := inputs.3[7:0];
  DUT.in4 := inputs.4[7:0];
  DUT.sel := 3'd0;
  assert_eq(DUT.y, y);
  step();
}

prot first<DUT: Mux5>(inputs: (u16, u32, u8, u64, u12), y: u8) {
  DUT.in0 := inputs.0[7:0];
  DUT.in1 := inputs.1[7:0];
  DUT.in2 := inputs.2[7:0];
  DUT.in3 := inputs.3[7:0];
  DUT.in4 := inputs.4[7:0];
  DUT.sel := 3'd1;
