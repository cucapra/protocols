prot fourth<DUT: Mux5>(inputs: (u8, u8, u8, u8, u8), y: u8) {
  DUT.in0 := inputs.0;
  DUT.in1 := inputs.1;
  DUT.in2 := inputs.2;
  DUT.in3 := inputs.3;
  DUT.in4 := inputs.4;
