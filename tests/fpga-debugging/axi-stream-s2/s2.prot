
struct AXISManager {
    // Active-low reset
    in M_AXIS_ARESETN: u1,              

    in M_AXIS_TREADY: u1,              

    out M_AXIS_TVALID: u1,              
    out M_AXIS_TDATA: u32,              
    
    // Indicates if the corresponding byte of `tdata` is a data byte 
    // or a "position byte" (e.g. offsets)
    out M_AXIS_TSTRB: u4,               
    
    // Indicates if this transfer is for the end of a packet
    out M_AXIS_TLAST: u1,               
}

prot reset<DUT: AXISManager>() {
    // Reset is active-low
    DUT.M_AXIS_ARESETN := 1'b0;        
    
    // AXI-Stream spec (section 2.7.2): during reset,
    // all other signals can be driven to any other value (i.e. are DontCare)
    step();
}

#[idle]
prot idle<DUT: AXISManager>() {
    DUT.M_AXIS_ARESETN := 1'b1;        
    assert_eq(DUT.M_AXIS_TVALID, 1'b0);
    
    // Note that ready can be either 0 or 1 during idle

    step();
}

// `tlast` is set to 0 for this protocol
prot recv<DUT: AXISManager>(data: u32, strb: u4) {
    DUT.M_AXIS_ARESETN := 1'b1;         
    DUT.M_AXIS_TREADY := 1'b1;      

    while (!(DUT.M_AXIS_TVALID == 1'b1)) {
        step();
    }    
    assert_eq(DUT.M_AXIS_TDATA, data);
    assert_eq(DUT.M_AXIS_TSTRB, strb);
    assert_eq(DUT.M_AXIS_TLAST, 1'b0);

    step();
}

// Like `recv`, but `tlast` is set to 1
prot recv_last<DUT: AXISManager>(data: u32, strb: u4) {
    DUT.M_AXIS_ARESETN := 1'b1;        
    DUT.M_AXIS_TREADY := 1'b1;         

    while (!(DUT.M_AXIS_TVALID == 1'b1)) {
        step();
    }    
    assert_eq(DUT.M_AXIS_TDATA, data);
    assert_eq(DUT.M_AXIS_TSTRB, strb);
    assert_eq(DUT.M_AXIS_TLAST, 1'b1);

    step();
}


// Stalls for `n + 1` clock cycles 
// (By a stall, we mean that there is backpressure, i.e. `valid = 1`
// but `ready = 0`)
prot stall<DUT: AXISManager>(data: u32, last: u1, strb: u4, n: uint) {
    DUT.M_AXIS_ARESETN := 1'b1;         
    DUT.M_AXIS_TREADY := 1'b0;          

    // Stall only applies when manager has valid data
    assert_eq(DUT.M_AXIS_TVALID, 1'b1);

    assert_eq(DUT.M_AXIS_TDATA, data);
    assert_eq(DUT.M_AXIS_TLAST, last);
    assert_eq(DUT.M_AXIS_TSTRB, strb);

    // Stall for n more cycles for any n >= 0
    repeat n iterations {
        step();
        
        // AXI-Stream spec (section 2.2.1): once valid 
        // has been asserted, it must remain asserted until the data transfer completes
        assert_eq(DUT.M_AXIS_TVALID, 1'b1);

        // Other output pins must also remain stable since valid is asserted
        assert_eq(DUT.M_AXIS_TDATA, data);
        assert_eq(DUT.M_AXIS_TLAST, last);
        assert_eq(DUT.M_AXIS_TSTRB, strb);
    }

    step();
}

