// trace 0
trace {
    reset();  // [time: 0ns -> 50ns]
    idle();  // [time: 25ns -> 50ns]
    idle();  // [time: 50ns -> 75ns]
    idle();  // [time: 100ns -> 125ns]
    idle();  // [time: 125ns -> 150ns]
    idle();  // [time: 150ns -> 175ns]
    idle();  // [time: 175ns -> 200ns]
    split_word(0xabcdabcdabcdabcd, 0x1f, 0x1);  // [time: 75ns -> 200ns]
    idle();  // [time: 200ns -> 200ns]
}
