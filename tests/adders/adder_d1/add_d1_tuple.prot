struct Adder {
  in a: u32,
  in b: u32,
  out s: u32,
}

// Same as `add_d1.prot`, but expressed using tuples instead
// to check that tuples are implemented correctly
prot add<DUT: Adder>(inputs: (u32, u32), s: u32) {
  DUT.a := inputs.0;
  DUT.b := inputs.1;
  step();
  DUT.a := X;
  DUT.b := X;
  assert_eq(s, DUT.s);

  fork();
  step();
}
